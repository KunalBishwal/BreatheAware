# OpenAQ v3 API
# Obtain key at https://explore.openaq.org
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_BASE_URL=https://api.openaq.org/v3

# CPCB / Data.gov.in API
# Obtain key at https://data.gov.in
CPCB_API_KEY=your_cpcb_api_key_here
CPCB_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# ML Microservice URL (FastAPI Cloud Run or local)
ML_SERVICE_URL=http://localhost:8000

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
