# ==========================================
# AIR QUALITY INTELLIGENCE & URBAN TRACKER
# Environment Configuration
# ==========================================

# OpenAQ v3 API Configuration
# Sign up at https://explore.openaq.org to obtain an API key
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Mode Configuration: 'live' or 'demo'
APP_MODE=demo

# Firebase / Google Cloud Firestore Configuration
# Get these values from your Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK Credentials (Optional: specify path to serviceAccountKey.json or set private key)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
